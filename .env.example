# Web 管理页面
WEB_LISTEN=[::]:8080

# 后台管理页和 API 登录账号
ADMIN_USERNAME=xmeng
ADMIN_PASSWORD=5201314

# 旧状态迁移及管理员初始线路的默认代理账号；新增用户使用自己的账号密码
SOCKS_USERNAME=xmeng
SOCKS_PASSWORD=5201314
SOCKS_LISTEN=::
SOCKS_UDP=true

# Hysteria2 Salamander 混淆密码
HY2_OBFS_PASSWORD=5201314

# HY2 IPv6 固定入口；留空时自动选择网卡的非轮换主 IPv6。
# 使用 Salamander 且服务器有多个 IPv6 时不能监听通配地址 ::，否则 Xray 可能从错误源地址回包。
HY2_LISTEN=

# 初始数量、起始端口、最大数量（最大不能超过 100）
INITIAL_PROXIES=10
BASE_PORT=20001
MAX_PROXIES=100
ROTATE_ALL_WORKERS=4

# 通常留空自动探测。多公网前缀或特殊网卡时再手动填写。
IPV6_INTERFACE=
IPV6_PREFIX=

# 换 IP 后的公网出口验证默认关闭；关闭时只确认新地址已成功添加并替换。
IP_CHECK_ENABLED=false
# auto 会自动识别中国大陆 IP；也可以设置为 cn 或 global 强制指定。
IP_CHECK_REGION=auto
# 国内使用 IPv6 纯文本接口，其他地区使用通用接口。
IP_CHECK_URL_CN=https://v6.api.myipdns.com/
IP_CHECK_URL=https://api64.ipify.org
IP_CHECK_TIMEOUT=10s
IP_CHECK_RETRIES=1
IP_COUNTRY_URL=https://api.country.is
DAD_TIMEOUT=8s

# HTTPS 证书主机名；线路复制和订阅始终使用当前访问面板的主机。
ADVERTISE_HOST=

# 设置后由 Python 面板和所有 HY2 入站共用该正式证书。
TLS_CERT_FILE=
TLS_KEY_FILE=

# SOCKS UDP 返回给客户端的服务器地址；留空时自动使用网卡 IPv4。
SOCKS_UDP_ADVERTISE_IP=

# Python 版直接运行，无需 Docker。Xray 默认安装到 /usr/local/bin/xray。
XRAY_BINARY=/usr/local/bin/xray
