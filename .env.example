# Web 管理页面
WEB_LISTEN=[::]:8080

# 后台管理页和 API 登录账号
ADMIN_USERNAME=xmeng
ADMIN_PASSWORD=5201314

# 旧状态迁移及管理员初始线路的默认代理账号；新增用户使用自己的账号密码
SOCKS_USERNAME=xmeng
SOCKS_PASSWORD=5201314
SOCKS_LISTEN=::
SOCKS_UDP=true

# Hysteria2 Salamander 混淆密码
HY2_OBFS_PASSWORD=5201314

# 初始数量、起始端口、最大数量（最大不能超过 100）
INITIAL_PROXIES=10
BASE_PORT=20001
MAX_PROXIES=100
ROTATE_ALL_WORKERS=4

# 通常留空自动探测。多公网前缀或特殊网卡时再手动填写。
IPV6_INTERFACE=
IPV6_PREFIX=

# 必须返回请求所用的公网 IP，支持纯文本或 {"ip":"..."} JSON。
IP_CHECK_URL=https://api6.ipify.org
IP_CHECK_TIMEOUT=10s
DAD_TIMEOUT=8s

# 页面复制连接地址时默认使用浏览器当前访问的主机；需要时可覆盖。
ADVERTISE_HOST=

# 设置后由 Python 面板和所有 HY2 入站共用该正式证书。
TLS_CERT_FILE=
TLS_KEY_FILE=

# SOCKS UDP 返回给客户端的服务器地址；留空时自动使用网卡 IPv4。
SOCKS_UDP_ADVERTISE_IP=

# Python 版直接运行，无需 Docker。Xray 默认安装到 /usr/local/bin/xray。
XRAY_BINARY=/usr/local/bin/xray
